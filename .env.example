# JiaLe Cloud 环境配置
# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# 云服务器地址（公网IP或域名）
CLOUD_HOST=your-server-ip

# frp 服务端地址（通常与 CLOUD_HOST 相同）
CLOUD_FRP_HOST=your-server-ip

# 数据库配置
DB_USERNAME=root
DB_PASSWORD=your-db-password

# JWT 密钥（请生成一个随机字符串替换）
JWT_SECRET=change-me-to-a-random-string

# 存储节点 Token
NODE_TOKEN=change-me

# 文件加密主密钥（64位十六进制字符串，请重新随机生成）
MASTER_KEY=change-me-to-a-64-char-hex-string

# 管理员账户
ADMIN_EMAIL=admin@yunpan.local
ADMIN_PASSWORD=your-admin-password

# 邮件配置（QQ邮箱 SMTP）
MAIL_USERNAME=your-email@qq.com
MAIL_PASSWORD=your-mail-auth-code
