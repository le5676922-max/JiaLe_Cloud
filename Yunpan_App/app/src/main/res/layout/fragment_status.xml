<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F2F2F4" android:clipToPadding="false">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingTop="12dp" android:paddingBottom="24dp">

        <!-- Status strip -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/card_bg" android:layout_marginHorizontal="12dp"
            android:padding="20dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="48dp" android:layout_height="48dp" android:text="☁"
                android:textSize="24sp" android:gravity="center" android:background="@drawable/icon_bg"
                android:layout_marginEnd="16dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/strip_title" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="等待连接" android:textSize="15sp"
                    android:textColor="#1C1C1E" android:textStyle="bold" />
                <TextView android:id="@+id/strip_sub" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="请先配置节点" android:textSize="13sp"
                    android:textColor="#8E8E93" android:layout_marginTop="2dp" />
            </LinearLayout>
            <TextView android:id="@+id/strip_badge" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="离线" android:textSize="12sp"
                android:textColor="#FF3B30" android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="12dp" android:paddingVertical="6dp"
                android:background="@drawable/badge_bg" />
        </LinearLayout>

        <!-- Capacity row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginHorizontal="12dp"
            android:layout_marginTop="10dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:background="@drawable/card_bg" android:padding="18dp"
                android:layout_marginEnd="5dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="总容量" android:textSize="12sp" android:textColor="#8E8E93"
                    android:fontFamily="sans-serif-medium" android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <TextView android:id="@+id/total_val" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--" android:textSize="28sp"
                        android:textColor="#1C1C1E" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text=" GB" android:textSize="14sp" android:textColor="#8E8E93" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="设备总空间" android:textSize="12sp" android:textColor="#8E8E93"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:background="@drawable/card_bg" android:padding="18dp"
                android:layout_marginStart="5dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="已使用" android:textSize="12sp" android:textColor="#8E8E93"
                    android:fontFamily="sans-serif-medium" android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <TextView android:id="@+id/used_val" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--" android:textSize="28sp"
                        android:textColor="#1C1C1E" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text=" GB" android:textSize="14sp" android:textColor="#8E8E93" />
                </LinearLayout>
                <TextView android:id="@+id/used_pct" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="--" android:textSize="12sp"
                    android:textColor="#8E8E93" android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Progress -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/card_bg" android:layout_marginHorizontal="12dp"
            android:layout_marginTop="10dp" android:padding="18dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="存储使用率" android:textSize="14sp"
                    android:textColor="#1C1C1E" android:textStyle="bold" />
                <TextView android:id="@+id/progress_pct" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0%" android:textSize="14sp"
                    android:textColor="#8E8E93" />
            </LinearLayout>
            <ProgressBar android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent"
                android:layout_height="6dp" android:layout_marginTop="10dp" android:max="100"
                android:progress="0" android:progressTint="#1C1C1E"
                android:progressBackgroundTint="#E5E5EA" />
        </LinearLayout>

        <!-- Speed -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/card_bg" android:layout_marginHorizontal="12dp"
            android:layout_marginTop="10dp" android:padding="18dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="传输速度" android:textSize="12sp" android:textColor="#8E8E93"
                android:fontFamily="sans-serif-medium" android:letterSpacing="0.05"
                android:layout_marginBottom="12dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingVertical="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="上传" android:textSize="14sp"
                    android:textColor="#1C1C1E" />
                <TextView android:id="@+id/speed_up" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="-- KB/s" android:textSize="14sp"
                    android:textColor="#1C1C1E" android:textStyle="bold" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#F2F2F4" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingVertical="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="下载" android:textSize="14sp"
                    android:textColor="#1C1C1E" />
                <TextView android:id="@+id/speed_down" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="-- KB/s" android:textSize="14sp"
                    android:textColor="#1C1C1E" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
